<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Projects</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%- include('partials/navbar', {page: '/solutions/projects'}) %>
    <div class="container mx-auto">
        <div class="hero bg-base-200">
            <div class="hero-content text-center">
                <div class="max-w-md">
                    <h1 class="text-5xl font-bold">Projects</h1>
                    <p>Filter by sector: <a href="/solutions/projects?sector=industry" class="btn">Industry</a></p>
                </div>
            </div>
        </div>
        <table class="table w-full">
            <thead>
                <tr><th>Title</th><th>Sector</th><th>Summary</th><th>Details</th></tr>
            </thead>
            <tbody>
                <% projects.forEach(project => { %>
                    <tr>
                        <td><%= project.title %></td>
                        <td><a href="/solutions/projects?sector=<%= project.sector %>" class="btn"><%= project.sector %></a></td>
                        <td><%= project.summary_short %></td>
                        <td><a href="/solutions/projects/<%= project.id %>" class="btn">Details</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>